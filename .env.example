# Copy to .env and fill in. Used by: pug init (writes here, then validates key), pug chew
# Never commit .env with real values — it is gitignored; keep keys local only.
ANTHROPIC_API_KEY=
# Optional: override the Claude model id (default: claude-sonnet-5-5). An exported PUG_MODEL wins over this line.
# PUG_MODEL=claude-sonnet-5-5
